PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Supabase: pooled (port 6543) for the app, direct (5432) for prisma migrate/db pull
DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:<password>@db.<ref>.supabase.co:5432/postgres"

# Upstash (rediss://...) or local redis://localhost:6379
REDIS_URL="rediss://default:<password>@<host>.upstash.io:6379"

JWT_ACCESS_SECRET=change-me
JWT_REFRESH_SECRET=change-me-too
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Email (needs `npm install nodemailer` in server/) / SMS. Leave blank to keep that channel off: such rows are logged as FAILED, not lost.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMS_API_URL=
SMS_API_KEY=

# true = deliver through BullMQ/Redis (run `npm run worker`; failed sends are retried 3 times). false/unset = send straight from the API.
USE_QUEUE=false
