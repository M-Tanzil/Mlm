  qty         Int
  price       Decimal  @db.Decimal(14, 2)
  bv          Decimal  @default(0) @db.Decimal(14, 2)
  gst_percent Decimal? @default(0) @db.Decimal(5, 2)
  orders      orders   @relation(fields: [order_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
