  city                                                     String?
  pincode                                                  String?
  address                                                  String?
  owner_user_id                                            BigInt?
  active                                                   Boolean                      @default(true)
  joining_package_deliveries                               joining_package_deliveries[]
  users                                                    users?                       @relation(fields: [owner_user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  orders                                                   orders[]
  pcr                                                      pcr[]
  stock_inward                                             stock_inward[]
  stock_ledger                                             stock_ledger[]
  stock_returns                                            stock_returns[]
  stock_transfers_stock_transfers_from_locationTolocations stock_transfers[]            @relation("stock_transfers_from_locationTolocations")
