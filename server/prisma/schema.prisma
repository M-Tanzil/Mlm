}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model member_ranks {
  member_id   BigInt
  rank_id     BigInt
  achieved_at DateTime    @default(now()) @db.Timestamptz(6)
  members     members     @relation(fields: [member_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  rank_master rank_master @relation(fields: [rank_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([member_id, rank_id])
