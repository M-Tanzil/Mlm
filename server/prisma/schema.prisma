generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model announcements {
  id         BigInt    @id @default(autoincrement())
  type       String
  title      String
  body       String?
  media_url  String?
  event_date DateTime? @db.Date
  published  Boolean   @default(true)
  created_at DateTime  @default(now()) @db.Timestamptz(6)
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model audit_logs {
  id            BigInt   @id @default(autoincrement())
  actor_user_id BigInt?
  action        String
  entity        String
  entity_id     String?
  before        Json?
  after         Json?
  ip            String?  @db.Inet
  created_at    DateTime @default(now()) @db.Timestamptz(6)
  users         users?   @relation(fields: [actor_user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model bank_transfers {
  id         BigInt    @id @default(autoincrement())
  payout_id  BigInt
  account_no String?
  ifsc       String?
  amount     Decimal   @db.Decimal(14, 2)
  utr_no     String?
  status     String    @default("PENDING")
  paid_at    DateTime? @db.Timestamptz(6)
  payouts    payouts   @relation(fields: [payout_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model binary_volume {
  member_id    BigInt   @id
  left_volume  Decimal  @default(0) @db.Decimal(14, 2)
  right_volume Decimal  @default(0) @db.Decimal(14, 2)
  left_carry   Decimal  @default(0) @db.Decimal(14, 2)
  right_carry  Decimal  @default(0) @db.Decimal(14, 2)
  left_count   Int      @default(0)
  right_count  Int      @default(0)
  updated_at   DateTime @default(now()) @db.Timestamptz(6)
  members      members  @relation(fields: [member_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model bonus_plans {
  id                BigInt              @id @default(autoincrement())
  code              String              @unique
  name              String
  frequency         String
  config            Json                @default("{}")
  active            Boolean             @default(true)
  commission_ledger commission_ledger[]
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model commission_ledger {
  id                                                BigInt         @id @default(autoincrement())
  member_id                                         BigInt
  bonus_code                                        String
  amount                                            Decimal        @db.Decimal(14, 2)
  cycle_id                                          BigInt?
  source_type                                       String?
  source_ref                                        String
  from_member_id                                    BigInt?
  level                                             Int?
  note                                              String?
  created_at                                        DateTime       @default(now()) @db.Timestamptz(6)
  bonus_plans                                       bonus_plans    @relation(fields: [bonus_code], references: [code], onDelete: NoAction, onUpdate: NoAction)
  payout_cycles                                     payout_cycles? @relation(fields: [cycle_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  members_commission_ledger_from_member_idTomembers members?       @relation("commission_ledger_from_member_idTomembers", fields: [from_member_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  members_commission_ledger_member_idTomembers      members        @relation("commission_ledger_member_idTomembers", fields: [member_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([member_id, bonus_code, source_ref])
  @@index([member_id, cycle_id], map: "idx_comm_member_cycle")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model company_info {
  id       BigInt  @id @default(autoincrement())
  name     String
  address  String?
  gstin    String?
  pan      String?
  email    String?
  phone    String?
  logo_url String?
  settings Json?   @default("{}")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model couriers {
  id                         BigInt                       @id @default(autoincrement())
  name                       String
  contact                    String?
  tracking_url_template      String?
  active                     Boolean?                     @default(true)
  dispatches                 dispatches[]
  joining_package_deliveries joining_package_deliveries[]
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model dispatches {
  id            BigInt    @id @default(autoincrement())
  order_id      BigInt    @unique
  courier_id    BigInt?
  tracking_no   String?
  dispatched_at DateTime? @db.Timestamptz(6)
  delivered_at  DateTime? @db.Timestamptz(6)
  status        String    @default("PENDING")
  couriers      couriers? @relation(fields: [courier_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  orders        orders    @relation(fields: [order_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model documents {
  id          BigInt  @id @default(autoincrement())
  title       String
  file_url    String
  audience    String? @default("ALL")
  uploaded_by BigInt?
  users       users?  @relation(fields: [uploaded_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model epin_requests {
  id           BigInt   @id @default(autoincrement())
  member_id    BigInt
  package_id   BigInt
  qty          Int
  status       String   @default("PENDING")
  processed_by BigInt?
  created_at   DateTime @default(now()) @db.Timestamptz(6)
  members      members  @relation(fields: [member_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  packages     packages @relation(fields: [package_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users        users?   @relation(fields: [processed_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  epins        epins[]
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model epins {
  id                               BigInt         @id @default(autoincrement())
  code                             String         @unique
  package_id                       BigInt
  status                           String         @default("GENERATED")
  request_id                       BigInt?
  issued_to                        BigInt?
  issued_at                        DateTime?      @db.Timestamptz(6)
  used_by                          BigInt?
  used_at                          DateTime?      @db.Timestamptz(6)
  created_by                       BigInt?
  created_at                       DateTime       @default(now()) @db.Timestamptz(6)
  users                            users?         @relation(fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  members_epins_issued_toTomembers members?       @relation("epins_issued_toTomembers", fields: [issued_to], references: [id], onDelete: NoAction, onUpdate: NoAction)
  packages                         packages       @relation(fields: [package_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  epin_requests                    epin_requests? @relation(fields: [request_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  members_epins_used_byTomembers   members?       @relation("epins_used_byTomembers", fields: [used_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  orders                           orders[]

  @@index([status, issued_to], map: "idx_epins_status")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model faqs {
