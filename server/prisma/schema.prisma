/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model members {
  id                                                          BigInt                       @id @default(autoincrement())
  member_code                                                 String                       @unique
  user_id                                                     BigInt                       @unique
  sponsor_id                                                  BigInt?
  parent_id                                                   BigInt?
  position                                                    String?                      @db.Char(1)
  path                                                        Unsupported("ltree")
  depth                                                       Int                          @default(0)
  sponsor_path                                                Unsupported("ltree")?
  package_id                                                  BigInt?
  full_name                                                   String
  dob                                                         DateTime?                    @db.Date
  gender                                                      String?
  address                                                     String?
  state                                                       String?
  city                                                        String?
  pincode                                                     String?
  pan_no                                                      String?
  aadhaar_no                                                  String?
  kyc_status                                                  String                       @default("PENDING")
  status                                                      String                       @default("ACTIVE")
  joined_at                                                   DateTime                     @default(now()) @db.Timestamptz(6)
  binary_volume                                               binary_volume?
  commission_ledger_commission_ledger_from_member_idTomembers commission_ledger[]          @relation("commission_ledger_from_member_idTomembers")
  commission_ledger_commission_ledger_member_idTomembers      commission_ledger[]          @relation("commission_ledger_member_idTomembers")
  epin_requests                                               epin_requests[]
  epins_epins_issued_toTomembers                              epins[]                      @relation("epins_issued_toTomembers")
  epins_epins_used_byTomembers                                epins[]                      @relation("epins_used_byTomembers")
  joining_package_deliveries                                  joining_package_deliveries[]
  kyc_documents                                               kyc_documents[]
  member_bank                                                 member_bank?
  member_ranks                                                member_ranks[]
  packages                                                    packages?                    @relation(fields: [package_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  members_members_parent_idTomembers                          members?                     @relation("members_parent_idTomembers", fields: [parent_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  other_members_members_parent_idTomembers                    members[]                    @relation("members_parent_idTomembers")
  members_members_sponsor_idTomembers                         members?                     @relation("members_sponsor_idTomembers", fields: [sponsor_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  other_members_members_sponsor_idTomembers                   members[]                    @relation("members_sponsor_idTomembers")
  users                                                       users                        @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  orders                                                      orders[]
  package_returns                                             package_returns[]
  payouts                                                     payouts[]
  scheme_qualifiers                                           scheme_qualifiers[]
  tds_records                                                 tds_records[]
  tickets                                                     tickets[]

  @@unique([parent_id, position])
  @@index([path], map: "idx_members_path", type: Gist)
  @@index([sponsor_id], map: "idx_members_sponsor")
  @@index([sponsor_path], map: "idx_members_sponsor_path", type: Gist)
  @@index([state, city], map: "idx_members_state_city")
}

