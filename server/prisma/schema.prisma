/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model orders {
  id             BigInt        @id @default(autoincrement())
  order_no       String        @unique
  member_id      BigInt
  location_id    BigInt
  type           String
  subtotal       Decimal       @db.Decimal(14, 2)
  gst_amount     Decimal       @default(0) @db.Decimal(14, 2)
  total          Decimal       @db.Decimal(14, 2)
  total_bv       Decimal       @default(0) @db.Decimal(14, 2)
  payment_mode   String?
  payment_status String        @default("PENDING")
  status         String        @default("PLACED")
  epin_id        BigInt?
  created_at     DateTime      @default(now()) @db.Timestamptz(6)
  dispatches     dispatches?
  order_items    order_items[]
  epins          epins?        @relation(fields: [epin_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  locations      locations     @relation(fields: [location_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  members        members       @relation(fields: [member_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([member_id, created_at(sort: Desc)], map: "idx_orders_member")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
