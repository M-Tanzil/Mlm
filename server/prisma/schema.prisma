  file_url    String
  status      String    @default("PENDING")
  remarks     String?
  reviewed_by BigInt?
  reviewed_at DateTime? @db.Timestamptz(6)
  members     members   @relation(fields: [member_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
